{
  "schemaVersion": 1,
  "id": "vframegen",
  "version": "${version}",
  "name": "VFrameGen",
  "description": "Frame generation for Minecraft's Vulkan (and OpenGL) renderer. Reprojects the last real frame with its depth buffer to show an extra frame between real ones.",
  "authors": [
    "JMLambo"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.jmlambo.vframegen.VFrameGen"
    ],
    "modmenu": [
      "io.github.jmlambo.vframegen.ModMenuIntegration"
    ]
  },
  "mixins": [
    "vframegen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
